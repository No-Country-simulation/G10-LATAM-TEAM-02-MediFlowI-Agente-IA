# ==============================================================================
# MediFlow — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como '.env' y completa con tus credenciales reales.
# NUNCA compartas ni subas tu archivo '.env' al repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI (Multimodal LLM)
# Obtén tu API Key gratuita en: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="tu_gemini_api_key_aqui"
GEMINI_MODEL="gemini-1.5-flash"

# ------------------------------------------------------------------------------
# 2. Oracle Cloud Infrastructure (OCI) — Capa Always Free
# Puedes usar la ruta a tu archivo de configuración ~/.oci/config o variables directas
# ------------------------------------------------------------------------------
OCI_CONFIG_FILE="~/.oci/config"
OCI_CONFIG_PROFILE="DEFAULT"
OCI_BUCKET_NAME="mediflow-documentos-clinicos"
OCI_NAMESPACE="tu_namespace_oci_aqui"
OCI_COMPARTMENT_OCID="ocid1.compartment.oc1..tu_compartment_ocid"

# Modo simulación local para OCI (True: guarda en local mock, False: sube a OCI Cloud)
OCI_MOCK_MODE=true

# ------------------------------------------------------------------------------
# 3. Orquestador n8n (Local o VM OCI)
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_WEBHOOK_URL="http://localhost:5678/webhook/triaje"
N8N_WEBHOOK_TIMEOUT=30

# ------------------------------------------------------------------------------
# 4. Alertas de Urgencia en Tiempo Real (Slack / Webhook)
# ------------------------------------------------------------------------------
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/tu/webhook/url"

# ------------------------------------------------------------------------------
# 5. Configuración General de la Aplicación
# ------------------------------------------------------------------------------
APP_ENV="development"
APP_PORT=8501
CONFIDENCE_THRESHOLD=0.85
