# ── Claves LLM ──────────────────────────────────────────────────────────────
# Google Gemini (primario)
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (fallback opcional)
OPENAI_API_KEY=your-openai-api-key-here

# ── API Security ─────────────────────────────────────────────────────────────
API_KEY=mediflow-dev-secret-key-change-in-prod

# ── OCI Object Storage ───────────────────────────────────────────────────────
OCI_USER_OCID=ocid1.user.oc1..your-user-ocid
OCI_TENANCY_OCID=ocid1.tenancy.oc1..your-tenancy-ocid
OCI_REGION=sa-saopaulo-1
OCI_FINGERPRINT=your-key-fingerprint
OCI_PRIVATE_KEY_PATH=/app/oci_private_key.pem
OCI_NAMESPACE=your-namespace
OCI_BUCKET_NAME=mediflow-documentos-clinicos

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Umbrales de score de confianza del agente
CONFIDENCE_THRESHOLD_HIGH=0.8
CONFIDENCE_THRESHOLD_LOW=0.5
