# ── MediFlow Frontend — Variables de Entorno ─────────────────────────────────
# URL base de la API REST del backend
# En desarrollo local con Docker Compose o localmente:
VITE_API_URL=http://localhost:8000/api/v1

# ── Configuración Opcional para Model Context Protocol (MCP) ─────────────────
# Activar la integración con servidores de herramientas MCP
VITE_MCP_ENABLED=false
# URL del servidor MCP local o remoto
VITE_MCP_SERVER_URL=http://localhost:8001/mcp
# Credenciales API Key / Token Bearer para el servidor MCP (NUNCA incluir claves reales aquí)
VITE_MCP_API_KEY=tu_api_key_mcp_aqui
# Protocolo de transporte: sse, websocket, o http
VITE_MCP_TRANSPORT=sse
# Tiempo de espera en milisegundos para llamadas a herramientas
VITE_MCP_TIMEOUT_MS=15000
# Lista separada por comas de herramientas autorizadas
VITE_MCP_ALLOWED_TOOLS=consultar_cie10,resumir_historia_clinica,calcular_urgencia
